---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createClient } from '@supabase/supabase-js';

const supabaseUrl = import.meta.env.SUPABASE_URL;
const supabaseAnonKey = import.meta.env.SUPABASE_ANON_KEY;
const supabase = createClient(supabaseUrl, supabaseAnonKey);

const token = Astro.cookies.get('sb-access-token')?.value;
if (!token) return Astro.redirect('/admin/kirjaudu');
const { data: { user } } = await supabase.auth.getUser(token);
if (!user) return Astro.redirect('/admin/kirjaudu');

const serviceSupabase = createClient(import.meta.env.SUPABASE_URL, import.meta.env.SUPABASE_SERVICE_ROLE_KEY);
const { data: adminUser } = await serviceSupabase.from('admin_users').select('user_id').eq('user_id', user.id).maybeSingle();
if (!adminUser) return Astro.redirect('/admin/kirjaudu');

const { data: products } = await serviceSupabase.from('products').select('*').order('created_at', { ascending: false });
---

<AdminLayout title="Tuotteet">
  <div class="mb-6">
    <button id="add-product-btn" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Lisää tuote</button>
  </div>

  <div id="product-form" class="hidden bg-white dark:bg-gray-800 rounded-lg shadow p-6 mb-6">
    <h3 class="text-lg font-semibold mb-4">Lisää tuote</h3>
    <form id="form-add-product" class="space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium mb-1">Nimi *</label>
          <input name="name" type="text" required class="w-full rounded border border-gray-300 px-3 py-2 dark:bg-gray-700" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">SKU</label>
          <input name="sku" type="text" placeholder="TEST-001" class="w-full rounded border border-gray-300 px-3 py-2 dark:bg-gray-700" />
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium mb-1">Kuvaus</label>
        <textarea name="description" rows="3" class="w-full rounded border border-gray-300 px-3 py-2 dark:bg-gray-700"></textarea>
      </div>
      <div class="grid grid-cols-3 gap-4">
        <div>
          <label class="block text-sm font-medium mb-1">Hinta (sentteinä) *</label>
          <input name="price_cents" type="number" required min="0" placeholder="1000" class="w-full rounded border border-gray-300 px-3 py-2 dark:bg-gray-700" />
          <p class="text-xs text-gray-500 mt-1">1000 = 10.00€</p>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Alv % *</label>
          <input name="vat_percent" type="number" required min="0" max="100" value="24" class="w-full rounded border border-gray-300 px-3 py-2 dark:bg-gray-700" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Varasto</label>
          <input name="stock" type="number" min="0" value="0" class="w-full rounded border border-gray-300 px-3 py-2 dark:bg-gray-700" />
        </div>
      </div>
      <div class="flex items-center gap-2">
        <input name="active" type="checkbox" checked id="active" class="rounded" />
        <label for="active" class="text-sm">Aktiivinen (näkyy kaupassa)</label>
      </div>
      <div class="flex gap-2">
        <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Tallenna</button>
        <button type="button" id="cancel-product-form" class="bg-gray-300 text-gray-700 px-4 py-2 rounded hover:bg-gray-400">Peruuta</button>
      </div>
      <p id="form-msg" class="text-sm text-red-600"></p>
    </form>
  </div>

  <div class="bg-white dark:bg-gray-800 rounded-lg shadow overflow-hidden">
    <table class="w-full">
      <thead class="bg-gray-50 dark:bg-gray-700">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase">Nimi</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase">SKU</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase">Hinta</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase">Varasto</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase">Tila</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase">Toiminnot</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
        {products?.map((p) => (
          <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
            <td class="px-6 py-4 text-sm font-medium">{p.name}</td>
            <td class="px-6 py-4 text-sm">{p.sku || '-'}</td>
            <td class="px-6 py-4 text-sm">{new Intl.NumberFormat('fi-FI', { style: 'currency', currency: 'EUR' }).format(p.price_cents / 100)}</td>
            <td class="px-6 py-4 text-sm">{p.stock}</td>
            <td class="px-6 py-4 text-sm">{p.active ? <span class="text-green-600">Aktiivinen</span> : <span class="text-gray-400">Piilotettu</span>}</td>
            <td class="px-6 py-4 text-right">
              <button class="text-red-600 hover:text-red-800 text-sm delete-btn" data-id={p.id}>Poista</button>
            </td>
          </tr>
        ))}
        {!products?.length && <tr><td colspan="6" class="px-6 py-8 text-center text-gray-500">Ei tuotteita</td></tr>}
      </tbody>
    </table>
  </div>

  <script>
    const addBtn = document.getElementById('add-product-btn');
    const formDiv = document.getElementById('product-form');
    const cancelBtn = document.getElementById('cancel-product-form');
    const form = document.getElementById('form-add-product') as HTMLFormElement;
    const msg = document.getElementById('form-msg') as HTMLParagraphElement;

    addBtn?.addEventListener('click', () => formDiv?.classList.remove('hidden'));
    cancelBtn?.addEventListener('click', () => {
      formDiv?.classList.add('hidden');
      form.reset();
      msg.textContent = '';
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const res = await fetch('/api/admin/products', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: fd.get('name'),
          sku: fd.get('sku') || null,
          description: fd.get('description') || null,
          price_cents: Number(fd.get('price_cents')),
          vat_percent: Number(fd.get('vat_percent')),
          stock: Number(fd.get('stock')),
          active: fd.get('active') === 'on',
        }),
      });
      const data = await res.json();
      if (res.ok) location.reload();
      else msg.textContent = data.error || 'Virhe';
    });

    document.querySelectorAll('.delete-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('Poistetaanko tuote?')) return;
        const id = (btn as HTMLElement).dataset.id;
        const res = await fetch(`/api/admin/products/${id}`, { method: 'DELETE' });
        if (res.ok) location.reload();
        else alert('Poisto epäonnistui');
      });
    });
  </script>
</AdminLayout>
