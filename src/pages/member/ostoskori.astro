---
export const prerender = false;
import LayoutCommon from '../../app/LayoutCommon.astro';
---

<LayoutCommon>
  <main class="max-w-2xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-6">Ostoskori</h1>
    <div id="cart-list" class="space-y-3"></div>
    <p id="cart-total" class="font-semibold mt-6"></p>
    <div class="mt-6 flex gap-3">
      <a href="/member/tuotteet" class="underline text-sm">Jatka ostoksia</a>
      <a href="/member/kassa" class="ml-auto bg-blue-600 text-white rounded px-4 py-2 text-sm">Siirry kassalle</a>
    </div>
  </main>
  <script>
    import { cartState, cartTotalCents, removeFromCart, setQty } from '../../stores/cart.ts';
    function fmt(cents: number){ return new Intl.NumberFormat('fi-FI',{style:'currency',currency:'EUR'}).format(cents/100); }
    function render(){
      const { items } = cartState.get();
      const list = document.getElementById('cart-list')!;
      const totalEl = document.getElementById('cart-total')!;
      if (items.length === 0){ list.innerHTML = '<p class="text-gray-600">Kori on tyhjä.</p>'; totalEl.textContent=''; return; }
      list.innerHTML = items.map(i => `
        <div class="flex items-center gap-3 bg-white dark:bg-gray-800 rounded p-3 shadow">
          <div class="flex-1"><div class="font-medium text-sm">${i.name}</div><div class="text-xs text-gray-500">${fmt(i.price_cents)} / kpl · Alv ${i.vat_percent}%</div></div>
          <input type="number" min="1" value="${i.qty}" data-id="${i.id}" class="qty w-16 rounded border px-2 py-1 text-sm" />
          <button data-remove="${i.id}" class="text-sm text-red-600">Poista</button>
        </div>`).join('');
      totalEl.textContent = 'Yhteensä: ' + fmt(cartTotalCents(items));
      list.querySelectorAll('.qty').forEach(inp => inp.addEventListener('change', () => {
        const el = inp as HTMLInputElement;
        setQty(el.dataset.id!, Number(el.value));
        render();
      }));
      list.querySelectorAll('[data-remove]').forEach(btn => btn.addEventListener('click', () => {
        removeFromCart((btn as HTMLElement).dataset.remove!);
        render();
      }));
    }
    render();
    cartState.listen(render);
  </script>
</LayoutCommon>
