---
export const prerender = false;
import LayoutCommon from '../../../app/LayoutCommon.astro';
import { getSupabaseServiceRole } from '../../../lib/supabase.js';

// Auth is enforced in middleware; this is SSR so we can fetch with service_role if needed.
// For now use anon read (RLS allows active products).
let products: Array<{ id: string; name: string; price_cents: number; vat_percent: number }> = [];
let error: string | null = null;
try {
  const supabase = getSupabaseServiceRole();
  const { data, error: err } = await supabase.from('products').select('id,name,price_cents,vat_percent').eq('active', true).order('name');
  if (err) throw err;
  products = data ?? [];
} catch (e: unknown) {
  error = (e as Error).message;
}
---

<LayoutCommon>
  <main class="max-w-5xl mx-auto px-4 py-8">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold">Tuotteet</h1>
      <div class="flex gap-2">
        <a href="/member/ostoskori" class="text-sm underline">Ostoskori</a>
        <a href="/api/auth/member-logout" class="text-sm underline text-gray-600">Kirjaudu ulos</a>
      </div>
    </div>
    {error && <p class="text-red-600 text-sm mb-4">Virhe: {error} — tarkista Supabase-avaimet ja että migraatio on ajettu.</p>}
    {!error && products.length === 0 && <p class="text-gray-600">Ei tuotteita vielä. Lisää tuotteita Supabasessa tai adminissa.</p>}
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {products.map((p) => (
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-4">
          <h2 class="font-semibold">{p.name}</h2>
          <p class="text-sm text-gray-600 dark:text-gray-400">{new Intl.NumberFormat('fi-FI', { style: 'currency', currency: 'EUR' }).format(p.price_cents / 100)} · Alv {p.vat_percent}%</p>
          <button class="mt-3 w-full bg-blue-600 text-white rounded py-2 text-sm hover:bg-blue-700 add-to-cart" data-id={p.id} data-name={p.name} data-price={p.price_cents} data-vat={p.vat_percent}>Lisää koriin</button>
        </div>
      ))}
    </div>
  </main>
  <script>
    import { addToCart } from '../../../stores/cart.ts';
    document.querySelectorAll('.add-to-cart').forEach((btn) => {
      btn.addEventListener('click', () => {
        const el = btn as HTMLElement;
        addToCart({
          id: el.dataset.id!,
          name: el.dataset.name!,
          price_cents: Number(el.dataset.price),
          vat_percent: Number(el.dataset.vat),
          qty: 1,
        });
        btn.textContent = 'Lisätty!';
        setTimeout(() => (btn.textContent = 'Lisää koriin'), 1200);
      });
    });
  </script>
</LayoutCommon>
