# Copy to .env (local) and set in Netlify > Site settings > Environment variables
PUBLIC_SITE_URL=http://localhost:2121
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # server only — never expose to client
RESEND_API_KEY=re_...
ADMIN_EMAIL=admin@tietosiru.fi
MEMBER_SESSION_SECRET=change-me-32+chars-random  # HMAC for httpOnly member cookie
